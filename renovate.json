{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.spec$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+) currentValue=(?<currentValue>[^\\s]+)\\n%define commit (?<currentDigest>[a-f0-9]{40})"
      ]
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "git-refs"
      ],
      "matchFileNames": [
        "**/*.spec"
      ],
      "commitMessageTopic": "{{depName}}"
    }
  ]
}
